#!/usr/bin/env python3
"""Cycle Hyprland scrolling column widths and show the preset via a DMS toast."""

import json
import subprocess
import sys
import time


def hyprctl(*args):
    return subprocess.run(
        ["hyprctl", *args], check=True, capture_output=True, text=True
    ).stdout.strip()


def active_window():
    return json.loads(hyprctl("activewindow", "-j"))


def show_width(address):
    try:
        # The originally resized window might no longer be focused by the time
        # the animation finishes. Identify it by address, not current focus.
        clients = json.loads(hyprctl("clients", "-j"))
        window = next(w for w in clients if w["address"] == address)
        if window.get("floating"):
            return
        monitors = json.loads(hyprctl("monitors", "-j"))
        monitor = next(m for m in monitors if m["id"] == window["monitor"])
        ratio = window["size"][0] / (monitor["width"] / monitor["scale"])
        setting = json.loads(hyprctl("getoption", "scrolling:explicit_column_widths", "-j"))
        presets = [float(x.strip()) for x in setting["str"].split(",")]
        index = min(range(len(presets)), key=lambda i: abs(ratio - presets[i]))
        percent = f"{presets[index] * 100:.2f}".rstrip("0").rstrip(".").replace(".", ",")
    except (KeyError, ValueError, StopIteration, IndexError, subprocess.CalledProcessError):
        return

    # Toast replaces the previous toast; does not create a notification entry.
    subprocess.run(
        ["dms", "ipc", "call", "toast", "info",
         f"Largeur : {percent} % ({index + 1}/{len(presets)})"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("prev", "next", "show"):
        print("Usage: scrolling-width-osd {prev|next|show}", file=sys.stderr)
        return 2

    try:
        window = active_window()
    except (ValueError, subprocess.CalledProcessError):
        return 1
    if not window or window.get("floating") or not window.get("address"):
        return 0

    if sys.argv[1] != "show":
        direction = "-" if sys.argv[1] == "prev" else "+"
        try:
            # A maximized window ignores scrolling column width changes until
            # its maximized state is cleared (fullscreen=1 in activewindow).
            if window.get("fullscreen") == 1:
                hyprctl("dispatch", 'hl.dsp.window.fullscreen({ mode = "maximized", action = "unset" })')
            hyprctl("dispatch", f'hl.dsp.layout("colresize {direction}conf")')
        except subprocess.CalledProcessError as exc:
            print(exc.stderr, file=sys.stderr)
            return 1
        # Hyprland animates column widths; an immediate size read is stale.
        time.sleep(0.45)

    show_width(window["address"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
